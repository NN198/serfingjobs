# ============================================
# JOB SCRAPER - Environment Variables
# ============================================
# 
# SECURITY WARNINGS:
# 1. NEVER commit the actual .env file to git
# 2. This .env.example is safe to commit (contains no real values)
# 3. If you accidentally expose API keys, rotate them immediately
# 4. Consider using a secrets manager (AWS Secrets Manager, HashiCorp Vault) 
#    for production deployments
#
# ============================================

# --------------------------------------------
# API KEYS (Required)
# --------------------------------------------

# SerpAPI - For Google Search scraping
# Get your key at: https://serpapi.com/
# Free tier: 100 searches/month
# Why SerpAPI: Legally scrapes Google, handles CAPTCHAs, returns structured JSON
SERP_API_KEY=your_serpapi_key_here

# --------------------------------------------
# DATABASE (Required)
# --------------------------------------------

# Redis - For caching search results
# Local: redis://localhost:6379
# Docker: redis://redis:6379
# Cloud: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# Redis password (if using authentication)
# Leave empty for local development without auth
REDIS_PASSWORD=

# --------------------------------------------
# SERVER (Optional)
# --------------------------------------------

# Server port (default: 3001)
PORT=3001

# Environment (development | production | test)
NODE_ENV=development

# --------------------------------------------
# RATE LIMITING (Optional)
# --------------------------------------------

# Max requests per minute per IP
RATE_LIMIT_MAX=60

# Rate limit window in milliseconds
RATE_LIMIT_WINDOW=60000

# --------------------------------------------
# SECURITY (Production Only)
# --------------------------------------------

# CORS allowed origins (comma-separated)
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# JWT secret for future auth implementation
# Generate with: openssl rand -base64 32
JWT_SECRET=
